# Copy to .env and fill in. Never commit the real .env.
# Generate a secret:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# HOSTED PostgreSQL (required in production). Neon/Supabase give you a URL like postgresql://user:pass@host/db?sslmode=require ;
# for this app write it with the psycopg driver prefix:  postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=

# The public address customers use (https:// in production). Stripe sends them back here after paying.
PUBLIC_BASE_URL=https://your-domain.example

# Payments (Stripe Checkout). Leave both empty to run without payments. sk_test_... = TEST mode (no real money), sk_live_... = real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Only if the web app is served from a different origin than the API:
CORS_ORIGINS=
ALLOW_REGISTRATION=true
PORT=8000
# only for `docker compose --profile localdb` (a throw-away local PostgreSQL):
POSTGRES_PASSWORD=devonly

# "Continue with Google" (optional). The OAuth *client ID* is public; create it in Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application, and add your site address (https://your-domain) under "Authorized JavaScript origins".
# Never put the client SECRET anywhere: this app does not use it.
GOOGLE_CLIENT_ID=
